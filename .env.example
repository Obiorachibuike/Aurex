# ───────────── Required ─────────────
# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, RDS…). Use the *pooled* URL on Vercel.
DATABASE_URL=postgresql://user:password@host:5432/aurex?sslmode=require
# Long random string used to sign order links and tokens. Generate: openssl rand -base64 48
AUTH_SECRET=
# Public address of the site, no trailing slash. Used in emails, payment callbacks and SEO tags.
APP_URL=https://www.example.ng
# Protects /api/cron. Vercel Cron sends it automatically as a Bearer token. Generate: openssl rand -hex 32
CRON_SECRET=

# ───────────── Payments (at least one gateway) ─────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# The "secret hash" you type in the Flutterwave dashboard under Webhooks.
FLUTTERWAVE_WEBHOOK_HASH=

# ───────────── Email (Resend) ─────────────
# Without a key, emails are recorded in Admin › Settings but not delivered.
RESEND_API_KEY=
EMAIL_FROM="AUREX <orders@example.ng>"

# ───────────── Product image uploads (Cloudinary) ─────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ───────────── AI assistant ─────────────
# Optional. With no key the built-in rule-based engine answers. Choose provider/model in Admin › AI assistant.
AGNES_API_KEY=
# AGNES_API_URL=https://apihub.agnes-ai.com/v1
OPENAI_API_KEY=
# Key for a custom OpenAI-compatible endpoint (its URL is set in the admin).
AI_CUSTOM_API_KEY=

# ───────────── Optional ─────────────
# Shared rate limiting across serverless instances (recommended in production). Falls back to the database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Error reporting.
SENTRY_DSN=
# DATABASE_POOL_MAX=5

# ───────────── Local development / testing only — never set in production ─────────────
# Stand-in for Paystack so checkout can be tested without keys (ignored on Vercel production):
# ENABLE_PAYMENT_SIMULATOR=true
# PAYSTACK_SECRET_KEY=sk_test_simulator
# PAYSTACK_API_URL=http://127.0.0.1:3000/api/dev/paystack-sim
# Allow cookies over plain http://localhost when running `npm start` locally:
# INSECURE_COOKIES=true
